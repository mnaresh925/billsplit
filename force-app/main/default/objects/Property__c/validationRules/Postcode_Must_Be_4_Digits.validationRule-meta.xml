<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Postcode_Must_Be_4_Digits</fullName>
    <active>true</active>
    <description>Australian postcodes have 4 digits.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Postcode__c)), NOT(REGEX(Postcode__c, &quot;[0-9]{4}&quot;)))</errorConditionFormula>
    <errorDisplayField>Postcode__c</errorDisplayField>
    <errorMessage>Enter a 4 digit postcode.</errorMessage>
</ValidationRule>
