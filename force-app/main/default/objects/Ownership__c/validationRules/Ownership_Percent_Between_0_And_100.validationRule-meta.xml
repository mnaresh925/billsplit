<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Ownership_Percent_Between_0_And_100</fullName>
    <active>true</active>
    <description>Ownership percent must be from 0% to 100%.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Ownership_Percent__c)), OR(Ownership_Percent__c &lt; 0, Ownership_Percent__c &gt; 1))</errorConditionFormula>
    <errorDisplayField>Ownership_Percent__c</errorDisplayField>
    <errorMessage>Ownership Percent must be between 0% and 100%.</errorMessage>
</ValidationRule>
