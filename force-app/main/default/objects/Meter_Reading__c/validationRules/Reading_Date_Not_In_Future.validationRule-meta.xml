<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reading_Date_Not_In_Future</fullName>
    <active>true</active>
    <description>A reading date cannot be after its bill's period end.</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Utility_Bill__c)), 
    Reading_Date__c > Utility_Bill__r.Period_End__c
)
</errorConditionFormula>
    <errorDisplayField>Reading_Date__c</errorDisplayField>
    <errorMessage>Reading Date cannot be after the bill period end.</errorMessage>
</ValidationRule>