<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reading_Value_Not_Negative</fullName>
    <active>true</active>
    <description>Meter readings are zero or more.</description>
    <errorConditionFormula>Reading_Value__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Reading_Value__c</errorDisplayField>
    <errorMessage>Reading Value cannot be negative.</errorMessage>
</ValidationRule>
