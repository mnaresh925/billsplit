<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Due_Date_Not_Before_Issue</fullName>
    <active>true</active>
    <description>Due date cannot be earlier than the issue date.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Due_Date__c)), NOT(ISBLANK(Issue_Date__c)), Due_Date__c &lt; Issue_Date__c)</errorConditionFormula>
    <errorDisplayField>Due_Date__c</errorDisplayField>
    <errorMessage>Due Date cannot be before Issue Date.</errorMessage>
</ValidationRule>
